# Lemon Squeezy Server-Side Checkout & Webhook Configuration (configure in Cloudflare Pages)
# NEVER commit real values or expose these variables to client-side browser code.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Optional canonical site origin used for Lemon Squeezy post-checkout redirect URLs
PUBLIC_APP_URL=
